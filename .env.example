# UPS API Configuration
# Note: These are example values. The service stubs HTTP calls and doesn't require real credentials.
UPS_CLIENT_ID=your_client_id_here
UPS_CLIENT_SECRET=your_client_secret_here
UPS_API_BASE_URL=https://onlinetools.ups.com/api
UPS_AUTH_URL=https://onlinetools.ups.com/security/v1/oauth/token

# Optional: Set to 'production' or 'development'
NODE_ENV=development

# Token Cache Settings (optional)
TOKEN_CACHE_BUFFER_SECONDS=300